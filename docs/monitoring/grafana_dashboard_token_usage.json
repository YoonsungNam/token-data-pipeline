    {
      "id": 8,
      "type": "text",
      "title": "참고: BATCH_RESULT 마커 패널",
      "datasource": {
        "type": "datasource",
        "uid": "grafana"
      },
      "gridPos": {
        "x": 18,
        "y": 32,
        "w": 6,
