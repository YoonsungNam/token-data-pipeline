          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.19.0",
          "queryType": "sql",
          "rawSql": "SELECT\n    user_name,\n    sum(total_input_tokens) AS total_input_tokens,\n    sum(requests) AS requests,\n    count(DISTINCT date) AS active_days\nFROM gpu_data.view_token_usage_1d_dist\nWHERE date BETWEEN toDate($__fromTime) AND toDate($__toTime)\n  AND user_type = 'anonymous'\nGROUP BY user_name\nORDER BY total_input_tokens DESC\nLIMIT 20",
          "refId": "A"
        }
