          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.19.0",
          "queryType": "sql",
          "rawSql": "SELECT\n    date,\n    count(DISTINCT service) AS reporting_services,\n    sum(requests) AS requests\nFROM gpu_data.view_token_usage_service_1d_dist\nWHERE date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nGROUP BY date\nORDER BY date DESC",
          "refId": "A"
        }
