      "pluginVersion": "11.6.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.19.0",
          "queryType": "sql",
          "rawSql": "SELECT\n    date AS time,\n    sum(if(org_path = ['unknown'], total_input_tokens, 0)) AS unknown_tokens,\n    sum(total_input_tokens) AS total_tokens,\n    round(sum(if(org_path = ['unknown'], total_input_tokens, 0)) / nullIf(sum(total_input_tokens), 0), 4) AS unknown_ratio\nFROM gpu_data.view_token_usage_org_1d_dist\nWHERE date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ]
    },
