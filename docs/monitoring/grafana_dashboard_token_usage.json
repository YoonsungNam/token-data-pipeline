        },
        "showHeader": true,
        "sortBy": []
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.19.0",
          "queryType": "sql",
          "rawSql": "SELECT\n    model,\n    provider,\n    sum(total_input_tokens) AS total_input_tokens,\n    sum(output_tokens) AS output_tokens,\n    sum(requests) AS requests,\n    sum(cost) AS cost\nFROM gpu_data.view_token_usage_model_1d_dist\nWHERE date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nGROUP BY model, provider\nORDER BY total_input_tokens DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "4. 서비스 대사 품질 (diff_* 비0 / summary 부재)",
      "description": "mart.agg_token_service_1d_dist — is_derived=0(=summary 대사 대상)인 서비스 중 diff_*가 0이 아니거나 reported_* 조인이 NULL(summary 미도착)인 행만 표시. reconcile_status: derived_no_summary(is_derived=1, 정상)/summary_missing(대사 대상인데 summary 부재)/mismatch(대사값 불일치).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.19.0",
          "queryType": "sql",
          "rawSql": "SELECT\n    date,\n    service_group,\n    service,\n    is_derived,\n    reported_input_tokens,\n    diff_input_tokens,\n    diff_cache_read_tokens,\n    diff_cache_creation_tokens,\n    diff_output_tokens,\n    diff_requests,\n    multiIf(\n        is_derived = 1, 'derived_no_summary',\n        reported_input_tokens IS NULL, 'summary_missing',\n        'mismatch'\n    ) AS reconcile_status\nFROM mart.agg_token_service_1d_dist\nWHERE date BETWEEN toDate($__fromTime) AND toDate($__toTime)\n  AND is_derived = 0\n  AND (\n        coalesce(diff_input_tokens, 0) != 0\n        OR coalesce(diff_cache_read_tokens, 0) != 0\n        OR coalesce(diff_cache_creation_tokens, 0) != 0\n        OR coalesce(diff_output_tokens, 0) != 0\n        OR coalesce(diff_requests, 0) != 0\n        OR reported_input_tokens IS NULL\n      )\nORDER BY date DESC, service",
          "refId": "A"
        }
      ]
    },
