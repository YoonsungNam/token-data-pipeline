        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.19.0",
          "queryType": "sql",
          "rawSql": "SELECT\n    date AS time,\n    service,\n    sum(total_input_tokens) AS total_input_tokens\nFROM gpu_data.view_token_usage_service_1d_dist\nWHERE date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nGROUP BY time, service\nORDER BY time",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "2. org 롤업 ($org_depth)",
      "description": "view_token_usage_org_1d_dist — arraySlice(org_path,1,$org_depth) 롤업 (변수 $org_depth 기본 1, 1~4)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "pluginVersion": "11.6.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.19.0",
          "queryType": "sql",
          "rawSql": "SELECT\n    arrayStringConcat(arraySlice(org_path, 1, $org_depth), '>') AS org,\n    sum(total_input_tokens) AS total_input_tokens,\n    sum(requests) AS requests,\n    sum(distinct_users) AS distinct_users,\n    sum(cost) AS cost\nFROM gpu_data.view_token_usage_org_1d_dist\nWHERE date BETWEEN toDate($__fromTime) AND toDate($__toTime)\nGROUP BY org\nORDER BY total_input_tokens DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "3. 모델별 토큰·cost",
      "description": "view_token_usage_model_1d_dist — 모델·provider별 토큰/요청/cost 집계",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
